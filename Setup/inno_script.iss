; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "Tooler"
#define MyAppVersion "1.5"
#define MyAppPublisher "AFNAN"
#define MyAppURL "https://github.com/afnan-nex/tooler"
#define MyAppIconName "Tooler.ico"

[Setup]
AppId={{1892E9AF-59DF-4846-880C-FBAFB699F9BF}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
OutputBaseFilename=Tooler
OutputDir=.
SetupIconFile={#MyAppIconName}
SolidCompression=yes
WizardStyle=modern
; FIX 1: Ensures the uninstaller runs with administrative privileges to modify Program Files
PrivilegesRequired=admin

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "{#MyAppIconName}"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{cmd}"; Parameters: "/c ""curl -L -o ""%TEMP%\tooler.ps1"" https://raw.githubusercontent.com/afnan-nex/tooler/main/tooler.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ""%TEMP%\tooler.ps1"""""; IconFilename: "{app}\{#MyAppIconName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{cmd}"; Parameters: "/c ""curl -L -o ""%TEMP%\tooler.ps1"" https://raw.githubusercontent.com/afnan-nex/tooler/main/tooler.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ""%TEMP%\tooler.ps1"""""; Tasks: desktopicon; IconFilename: "{app}\{#MyAppIconName}"

[Run]
Filename: "{cmd}"; Parameters: "/c ""curl -L -o ""%TEMP%\tooler.ps1"" https://raw.githubusercontent.com/afnan-nex/tooler/main/tooler.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ""%TEMP%\tooler.ps1"""""; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: postinstall skipifsilent

[UninstallDelete]
Type: filesandordirs; Name: "{app}"

; FIX 2: A code block that forces directory deletion after the uninstaller releases its own files
[Code]
procedure CurUninstallStepChanged(JustAfterAnUninstall: TUninstallStep);
begin
  if JustAfterAnUninstall = usPostUninstall then
  begin
    if DirExists(ExpandConstant('{app}')) then
    begin
      DelTree(ExpandConstant('{app}'), True, True, True);
    end;
  end;
end;